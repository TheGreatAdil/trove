{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Trove",
  "version": "0.1.0",
  "identifier": "com.absideon.trove",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Trove",
        "width": 1280,
        "height": 820,
        "minWidth": 520,
        "minHeight": 420,
        "backgroundColor": "#ebeae5",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPCACHE/sessions/**", "$APPCACHE/thumbs/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "fileAssociations": [
      {
        "ext": ["trv"],
        "name": "Trove Project",
        "description": "Trove project",
        "role": "Editor",
        "rank": "Owner",
        "mimeType": "application/x-trove-project",
        "exportedType": {
          "identifier": "com.absideon.trove.project",
          "conformsTo": ["public.data"]
        }
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
